{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/wrangler%404.151.0/packages/wrangler/config-schema.json",
  "name": "horizonbrief",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": false
  },
  "previews": {}
}
